# ---- 代码库：只传程序，不传数据 ----

# ---- 被试原始数据（含真实姓名，PHI 隐私） ----
# 排除所有内容，但保留 .gitkeep 以维持目录结构
data/cpt-results/*
!data/cpt-results/.gitkeep

# ---- 运行产物 / 可再生输出 ----
data/cpt-reports/*
!data/cpt-reports/.gitkeep
data/autotest/**/*
!data/autotest/**/.gitkeep

# ---- 私有/授权刺激材料：严禁提交到公开仓库 ----
private/
private-*/
*.licensed-stimuli.js
*.licensed-stimuli.json

# ---- 文档 / PDF 大文件（含队列 PHI 风险） ----
docs/*.pdf

# ---- WorkBuddy 项目记忆（含对话摘要与个人背景） ----
.workbuddy/

# ---- 环境 / 系统杂项 ----
.DS_Store
Thumbs.db
*.log
node_modules/
nul
